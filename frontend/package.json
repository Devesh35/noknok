{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n auth,next -c yellow,cyan \"firebase emulators:start --only auth --project demo-noknok\" \"next dev\"",
    "dev:next": "next dev",
    "build": "next build && node --env-file-if-exists=.env.local scripts/check-bundle-secrets.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "firebase emulators:exec --only auth --project demo-noknok \"vitest run\"",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx --env-file-if-exists=.env.local"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@tanstack/react-query": "^5.104.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "fuse.js": "^7.5.0",
    "leaflet": "^1.9.4",
    "mongoose": "^9.11.1",
    "next": "16.3.8",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.66.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "firebase-tools": "^15.33.0",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
