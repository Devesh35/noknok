# Copy to .env.local. Everything is optional in development: with no keys the
# app runs on an in-memory MongoDB, the Firebase Auth emulator, OpenStreetMap
# and the fake payment gateway. Adding a real service is a change here, not in
# code. Restart `npm run dev` after changing anything.
#
# Rule (PLATFORM_PLAN §9): only NEXT_PUBLIC_* values reach the browser, and
# only the names listed in src/server/config.ts. Never prefix a secret.

# ---------- MongoDB ----------
# Empty in development = an in-memory replica set, discarded when the server stops.
MONGODB_URI=

# ---------- Firebase Auth: phone login only ----------
# Browser (public by design; restrict the key in Google Cloud Console to the
# Identity Toolkit API and our referrers, and turn on App Check).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 1 = use the Auth emulator (started by `npm run dev`). Unset = emulator when
# no API key is set and not in production. Production refuses 1.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=
# reCAPTCHA Enterprise site key for App Check. Empty = App Check off.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Server. Base64 of the service-account JSON (`base64 -w0 key.json`).
# Empty = emulator. Required in production.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
# Set automatically when the emulator is in use (127.0.0.1:9099).
FIREBASE_AUTH_EMULATOR_HOST=

# HMAC secret for the 15-minute signup token. Random per start in
# development; required in production (`openssl rand -hex 32`).
SIGNUP_TOKEN_SECRET=

# ---------- Google Maps Platform ----------
# osm | google. google needs the browser key below; otherwise OSM is drawn.
NEXT_PUBLIC_MAP_PROVIDER=osm
# Maps JavaScript API only, HTTP-referrer restricted, daily quota capped.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# For Advanced Markers. Empty = Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Places API (New) + Geocoding, server only. Empty = Nominatim.
GOOGLE_MAPS_SERVER_KEY=

# ---------- Payments ----------
# fake (instant, development only) | razorpay | phonepe. Production refuses fake.
PAYMENT_PROVIDER=fake
# test (Razorpay test keys / PhonePe UAT) | live
PAYMENT_ENV=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ---------- App ----------
# Public origin, used for gateway return URLs (/pay/return).
APP_URL=http://localhost:3000
# Shared secret the cron caller sends in x-job-secret to POST /api/jobs/tick.
JOB_SECRET=
# Name of the session cookie.
SESSION_COOKIE=nn_session
