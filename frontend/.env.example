# Copy to .env.local. With no keys the app runs on an in-memory MongoDB,
# OpenStreetMap and the fake payment gateway; phone login needs the Firebase
# values below. Adding a real service is a change here, not in code. Restart
# `npm run dev` after changing anything.
#
# Files (all gitignored except this one):
#   .env.local   local development
#   .env.vercel  production values to paste into Vercel -> Settings -> Environment Variables
#   keys/        downloaded service-account JSON and other raw credentials
#
# Rule (PLATFORM_PLAN §9): only NEXT_PUBLIC_* values reach the browser, and
# only the names listed in src/server/config.ts. Never prefix a secret.

# ---------- MongoDB ----------
# Empty in development = an in-memory replica set, discarded when the server stops.
# Atlas (Mumbai): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Use a different <db> for dev and production. Allow Vercel's egress in Atlas Network Access.
MONGODB_URI=

# ---------- Firebase Auth: phone login only ----------
# Console: Build -> Authentication -> Sign-in method -> Phone (enable; add
# "Phone numbers for testing"); Settings -> Authorized domains (add the Vercel
# domain). Real SMS needs the Blaze plan.
# Browser values: Project settings -> General -> Your apps -> SDK setup. Public
# by design; restrict the key in Google Cloud Console -> Credentials to the
# Identity Toolkit API and our referrers, and turn on App Check.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check (Google Cloud -> reCAPTCHA
# Enterprise -> Create key, then Firebase -> App Check -> register the web
# app with the same key). Empty = App Check off.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Development only (ignored in production builds): 1 = no reCAPTCHA, no App
# Check; only Firebase "Phone numbers for testing" work, with their fixed codes.
NEXT_PUBLIC_FIREBASE_TEST_MODE=

# Server. Project settings -> Service accounts -> Generate new private key.
# Save the JSON under keys/ and paste its base64 here (one line).
#   bash:       base64 -w0 keys/<file>.json
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("keys\<file>.json"))
# Empty = phone login reports NOT_CONFIGURED. Required in production.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# HMAC secret for the 15-minute signup token. Random per start in
# development; required in production (`openssl rand -hex 32`).
SIGNUP_TOKEN_SECRET=

# ---------- Google Maps Platform ----------
# osm | google. google needs the browser key below; otherwise OSM is drawn.
NEXT_PUBLIC_MAP_PROVIDER=osm
# Maps JavaScript API only, HTTP-referrer restricted, daily quota capped.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# For Advanced Markers. Empty = Google's DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Places API (New) + Geocoding, server only. Empty = Nominatim.
GOOGLE_MAPS_SERVER_KEY=

# ---------- Payments ----------
# fake (instant, development only) | razorpay. Production refuses fake.
# Razorpay: Dashboard -> Settings -> API Keys; Webhooks -> add <APP_URL>/api/webhooks/razorpay.
PAYMENT_PROVIDER=fake
# test (Razorpay test keys) | live
PAYMENT_ENV=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- App ----------
# Public origin, used for gateway return URLs (/pay/return). Production: the
# deployed domain, also registered as the gateway webhook base
# (/api/webhooks/razorpay).
APP_URL=http://localhost:3000
# /api/jobs/tick accepts either secret (`openssl rand -hex 32` each).
# JOB_SECRET: sent as x-job-secret by a custom scheduler (QStash, curl; POST).
# CRON_SECRET: sent by Vercel Cron as `Authorization: Bearer` (GET); Vercel
# reads the variable of exactly this name. vercel.json runs it every 5 minutes
# (a payment hold is 10). Production refuses to start with neither set.
JOB_SECRET=
CRON_SECRET=
# Name of the session cookie.
SESSION_COOKIE=nn_session
# The /dev page and /api/dev/* (log in as anyone, move the clock, WIPE THE
# DATABASE). Never available in production. Otherwise on by itself only with
# the in-memory database; set 1 to allow it against a real MONGODB_URI.
DEV_TOOLS=
